---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, getLangFromUrl } from '../i18n/translations';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Placeholder projects — replace with real ones
const projects = [
  {
    name: 'rebjak.com',
    desc: lang === 'sk'
      ? 'Osobný web postavený na Astro 5 s i18n, dark modom a blogom.'
      : 'Personal website built with Astro 5, featuring i18n, dark mode and blog.',
    tags: ['Astro', 'Tailwind', 'TypeScript'],
    url: 'https://rebjak.com',
    source: 'https://github.com/jozefrebjak/rebjak.com',
  },
];
---

<BaseLayout title={t('portfolio.title')} description={t('portfolio.subtitle')}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-10">
      <h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-100 mb-3">{t('portfolio.title')}</h1>
      <p class="text-zinc-600 dark:text-zinc-400">{t('portfolio.subtitle')}</p>
    </div>

    <div class="grid sm:grid-cols-2 gap-5">
      {projects.map(({ name, desc, tags, url, source }) => (
        <article class="flex flex-col p-5 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
          <h2 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-2">{name}</h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-4 flex-1">{desc}</p>
          <div class="flex flex-wrap gap-1.5 mb-4">
            {tags.map((tag) => (
              <span class="px-2 py-0.5 rounded text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                {tag}
              </span>
            ))}
          </div>
          <div class="flex gap-3 text-sm">
            {url && (
              <a
                href={url}
                target="_blank"
                rel="noopener"
                class="text-[var(--color-brand)] dark:text-[var(--color-brand-dark)] hover:underline font-medium"
              >
                {t('portfolio.view')} →
              </a>
            )}
            {source && (
              <a
                href={source}
                target="_blank"
                rel="noopener"
                class="text-zinc-500 dark:text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:underline"
              >
                {t('portfolio.source')}
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
