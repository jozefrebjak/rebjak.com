---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/translations';

const lang = 'en' as const;
const t = useTranslations(lang);

const experience = [
  {
    role: 'NetDevOps Engineer',
    company: '—',
    period: 'present',
    desc: 'Network infrastructure management, configuration automation, Linux server administration and writing tooling to streamline ops work.',
  },
];

const skillGroups = [
  {
    label: 'Networking',
    skills: ['TCP/IP', 'BGP', 'OSPF', 'VLANs', 'VPN', 'Firewall', 'Mikrotik', 'Cisco'],
  },
  {
    label: 'Linux',
    skills: ['Debian', 'Ubuntu', 'RHEL', 'systemd', 'bash', 'cron', 'SSH', 'iptables'],
  },
  {
    label: 'Automation',
    skills: ['Ansible', 'Python', 'Bash scripting', 'Git', 'CI/CD', 'Docker'],
  },
  {
    label: 'Code',
    skills: ['Python', 'TypeScript', 'PHP', 'REST API', 'Astro', 'Tailwind'],
  },
  {
    label: 'Monitoring',
    skills: ['Zabbix', 'Grafana', 'Prometheus', 'syslog', 'SNMP'],
  },
];
---

<BaseLayout title={t('cv.title')}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-12">
      <h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-100 mb-2">{t('cv.title')}</h1>
      <p class="text-zinc-500 dark:text-zinc-400">Jozef Rebjak · NetDevOps</p>
    </div>

    <section class="mb-12">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mb-6 pb-2 border-b border-zinc-200 dark:border-zinc-800">
        {t('cv.experience')}
      </h2>
      <div class="space-y-8">
        {experience.map(({ role, period, desc }) => (
          <div class="grid sm:grid-cols-[1fr_auto] gap-1 sm:gap-4">
            <div>
              <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">{role}</h3>
              <p class="text-zinc-600 dark:text-zinc-400 text-sm mt-2">{desc}</p>
            </div>
            <p class="text-sm text-zinc-500 dark:text-zinc-400 whitespace-nowrap sm:text-right">{period}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mb-6 pb-2 border-b border-zinc-200 dark:border-zinc-800">
        {t('cv.skills')}
      </h2>
      <div class="space-y-5">
        {skillGroups.map(({ label, skills }) => (
          <div>
            <p class="text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-2">{label}</p>
            <div class="flex flex-wrap gap-2">
              {skills.map((skill) => (
                <span class="px-3 py-1 rounded-full text-sm font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
