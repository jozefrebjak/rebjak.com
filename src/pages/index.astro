---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, getLangFromUrl } from '../i18n/translations';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title="Jozef Rebjak" description={t('hero.tagline')}>
  <!-- Hero -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-20 sm:py-32">
    <div class="max-w-2xl">
      <p class="text-[var(--color-brand)] dark:text-[var(--color-brand-dark)] font-mono text-sm font-medium mb-4 tracking-wide">
        {t('hero.greeting')} Jozef 👋
      </p>
      <h1 class="text-4xl sm:text-5xl font-bold text-zinc-900 dark:text-zinc-100 leading-tight mb-6">
        {t('hero.tagline')}
      </h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed mb-10">
        {lang === 'sk'
          ? 'Softvérový vývojár so záujmom o čistý kód, dobré nástroje a veci, ktoré jednoducho fungujú. Píšem o veciach, ktoré sa naučím.'
          : 'Software developer interested in clean code, good tools and things that simply work. I write about things I learn.'}
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={lang === 'en' ? '/en/cv' : '/cv'}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 text-sm font-medium hover:bg-zinc-700 dark:hover:bg-zinc-300 transition-colors"
        >
          {t('hero.cta.cv')}
        </a>
        <a
          href={lang === 'en' ? '/en/portfolio' : '/portfolio'}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 text-sm font-medium hover:border-zinc-400 dark:hover:border-zinc-500 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors"
        >
          {t('hero.cta.portfolio')}
        </a>
        <a
          href={lang === 'en' ? '/en/blog' : '/blog'}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 text-sm font-medium hover:border-zinc-400 dark:hover:border-zinc-500 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors"
        >
          {t('hero.cta.blog')}
        </a>
      </div>
    </div>
  </section>

  <!-- Quick links section -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 pb-16">
    <div class="grid sm:grid-cols-3 gap-4">
      {[
        {
          href: lang === 'en' ? '/en/cv' : '/cv',
          icon: '📄',
          title: t('nav.cv'),
          desc: lang === 'sk' ? 'Skúsenosti, vzdelanie, zručnosti' : 'Experience, education, skills',
        },
        {
          href: lang === 'en' ? '/en/portfolio' : '/portfolio',
          icon: '🛠',
          title: t('nav.portfolio'),
          desc: lang === 'sk' ? 'Projekty a práce' : 'Projects and work',
        },
        {
          href: lang === 'en' ? '/en/blog' : '/blog',
          icon: '✍️',
          title: t('nav.blog'),
          desc: lang === 'sk' ? 'Články a poznámky' : 'Articles and notes',
        },
      ].map(({ href, icon, title, desc }) => (
        <a
          href={href}
          class="group flex flex-col gap-2 p-5 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700 hover:bg-zinc-50 dark:hover:bg-zinc-900/50 transition-all"
        >
          <span class="text-2xl">{icon}</span>
          <span class="font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-[var(--color-brand)] dark:group-hover:text-[var(--color-brand-dark)] transition-colors">
            {title}
          </span>
          <span class="text-sm text-zinc-500 dark:text-zinc-400">{desc}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
