---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, getLangFromUrl } from '../i18n/translations';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const experience = [
  {
    role: lang === 'sk' ? 'Systémový administrátor & vývojár' : 'System Administrator & Developer',
    company: 'ICT Solutions, s.r.o.',
    period: `09/2019 — ${t('cv.present')}`,
    desc: lang === 'sk'
      ? 'Správa Linux serverov, Docker Swarm a Proxmox klastrov. Prevádzka a rozvoj interných služieb: KEA DHCP, PowerDNS, celý Prometheus monitoring stack (Prometheus, Alertmanager, Grafana). Vývoj interných nástrojov a automatizácia procesov. Stále aktívna účasť na správe sieťovej infraštruktúry.'
      : 'Linux server management, Docker Swarm and Proxmox cluster operations. Running and developing internal services: KEA DHCP, PowerDNS, full Prometheus monitoring stack (Prometheus, Alertmanager, Grafana). Internal tooling development and process automation. Ongoing involvement in network infrastructure management.',
  },
  {
    role: lang === 'sk' ? 'Sieťový administrátor' : 'Network Administrator',
    company: 'GeCom, s.r.o.',
    period: '09/2017 — 09/2019',
    desc: lang === 'sk'
      ? 'Správa a rozvoj sieťovej infraštruktúry internetového providera (ISP) v regióne Zemplín. Konfigurácia a monitoring smerovačov, prepínačov a firewallov. Riešenie výpadkov a optimalizácia siete.'
      : 'Management and development of network infrastructure for a regional ISP. Configuration and monitoring of routers, switches and firewalls. Outage resolution and network optimization.',
  },
  {
    role: lang === 'sk' ? 'Sieťový technik (projekt)' : 'Network Technician (project)',
    company: 'ICT Solutions, s.r.o.',
    period: '06/2017 — 08/2017',
    desc: lang === 'sk'
      ? 'Prvý kontakt s IT prostredím po štúdiu na Vysokej škole manažmentu. Práca na migračnom projekte — príprava konfigurácií pre Cisco access switche a postupná náhrada zariadení Avaya za Cisco on-site (kus za kus). Konfigurácie sa nahrávali manuálne cez terminál, bez automatizácie.'
      : 'First exposure to IT after studying at the University of Management. Worked on a network migration project — preparing configurations for Cisco access switches and on-site replacement of Avaya devices with Cisco (one by one). Configurations were applied manually via terminal, no automation.',
  },
];

const skillGroups = [
  {
    label: lang === 'sk' ? 'Siete' : 'Networking',
    skills: ['TCP/IP', 'BGP', 'OSPF', 'VLANs', 'VPN', 'Firewall', 'Mikrotik', 'Cisco'],
  },
  {
    label: 'Linux',
    skills: ['Debian', 'Ubuntu', 'RHEL', 'systemd', 'bash', 'cron', 'SSH', 'iptables', 'nftables'],
  },
  {
    label: lang === 'sk' ? 'Infraštruktúra' : 'Infrastructure',
    skills: ['Proxmox', 'Docker Swarm', 'KVM', 'LXC'],
  },
  {
    label: lang === 'sk' ? 'Služby' : 'Services',
    skills: ['KEA DHCP', 'PowerDNS', 'Nginx', 'HAProxy'],
  },
  {
    label: lang === 'sk' ? 'Monitorovanie' : 'Monitoring',
    skills: ['Prometheus', 'Alertmanager', 'Grafana', 'Loki', 'SNMP', 'syslog'],
  },
  {
    label: lang === 'sk' ? 'Automatizácia & kód' : 'Automation & code',
    skills: ['Ansible', 'Python', 'Bash', 'Git', 'CI/CD', 'TypeScript', 'PHP'],
  },
];
---

<BaseLayout title={t('cv.title')}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-100 mb-2">{t('cv.title')}</h1>
      <p class="text-zinc-500 dark:text-zinc-400">Jozef Rebjak · NetDevOps</p>
    </div>

    <!-- Experience -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mb-6 pb-2 border-b border-zinc-200 dark:border-zinc-800">
        {t('cv.experience')}
      </h2>
      <div class="space-y-8">
        {experience.map(({ role, company, period, desc }) => (
          <div class="grid sm:grid-cols-[1fr_auto] gap-1 sm:gap-4">
            <div>
              <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">{role}</h3>
              {company !== '—' && (
                <p class="text-[var(--color-brand)] dark:text-[var(--color-brand-dark)] text-sm font-medium">{company}</p>
              )}
              <p class="text-zinc-600 dark:text-zinc-400 text-sm mt-2">{desc}</p>
            </div>
            <p class="text-sm text-zinc-500 dark:text-zinc-400 whitespace-nowrap sm:text-right">{period}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100 mb-6 pb-2 border-b border-zinc-200 dark:border-zinc-800">
        {t('cv.skills')}
      </h2>
      <div class="space-y-5">
        {skillGroups.map(({ label, skills }) => (
          <div>
            <p class="text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-2">{label}</p>
            <div class="flex flex-wrap gap-2">
              {skills.map((skill) => (
                <span class="px-3 py-1 rounded-full text-sm font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
