---
import {
  useTranslations,
  getAlternatePath,
  type Lang,
} from "../i18n/translations";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang: Lang;
  alternatePath?: string;
}

const { lang, alternatePath: alternateProp } = Astro.props;
const t = useTranslations(lang);

const prefix = lang === "en" ? "/en" : "";

const navLinks = [
  { href: `${prefix}/`, label: t("nav.home") },
  { href: `${prefix}/cv`, label: t("nav.cv") },
  { href: `${prefix}/portfolio`, label: t("nav.portfolio") },
  { href: `${prefix}/blog`, label: t("nav.blog") },
];

const alternatePath =
  alternateProp ?? getAlternatePath(Astro.url, lang === "sk" ? "en" : "sk");
const currentPath = Astro.url.pathname;
---

<!-- ── Desktop header (hidden on mobile) ───────────────────── -->
<header
  class="hidden sm:block sticky top-0 z-50 border-b border-zinc-200/60 dark:border-white/[0.06] bg-[#f8f9fb]/80 dark:bg-[#080c12]/80 backdrop-blur-md"
>
  <div
    class="max-w-4xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between"
  >
    <a
      href={prefix || "/"}
      class="font-mono font-semibold text-sm tracking-tight text-zinc-900 dark:text-zinc-100 hover:opacity-80 transition-opacity"
    >
      rebjak<span
        class="text-transparent bg-clip-text"
        style="background-image: linear-gradient(135deg, var(--color-brand-dark), var(--color-violet-dark))"
        >.com</span
      >
    </a>

    <div class="flex items-center gap-1">
      <nav class="flex items-center gap-0.5">
        {
          navLinks.map(({ href, label }) => {
            const isActive =
              currentPath === href ||
              (href !== (prefix || "/") && currentPath.startsWith(href));
            return (
              <a
                href={href}
                class:list={[
                  "px-3 py-1.5 rounded-md text-xs font-mono font-medium tracking-wide transition-all",
                  isActive
                    ? "text-[var(--color-brand-dark)] bg-[var(--color-brand-dark)]/10"
                    : "text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100/80 dark:hover:bg-white/[0.05]",
                ]}
              >
                {label}
              </a>
            );
          })
        }
      </nav>
      <div class="w-px h-4 bg-zinc-200 dark:bg-white/10 mx-1"></div>
      <a
        href={alternatePath}
        class="px-3 py-1.5 rounded-md text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100/80 dark:hover:bg-white/[0.05] transition-all"
        title={t("lang.switch")}
      >
        {lang === "sk" ? "EN" : "SK"}
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<!-- ── FAB button (mobile only) ────────────────────────────── -->
<button
  id="fab-open"
  class="sm:hidden fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full shadow-2xl flex items-center justify-center"
  style="background: linear-gradient(135deg, var(--color-brand-dark), var(--color-violet-dark));"
  aria-label="Menu"
>
  <svg
    id="fab-icon-menu"
    class="w-5 h-5 text-white"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2.5"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
  <svg
    id="fab-icon-close"
    class="w-5 h-5 text-white hidden"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2.5"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M6 18L18 6M6 6l12 12"></path>
  </svg>
</button>

<!-- ── Full-screen mobile overlay ──────────────────────────── -->
<div
  id="fab-overlay"
  class="sm:hidden fixed inset-0 z-40 flex flex-col pointer-events-none opacity-0"
  style="background: rgba(8, 12, 18, 0.97); backdrop-filter: blur(20px);"
>
  <!-- Top bar: logo + theme toggle -->
  <div
    class="flex items-center justify-between px-6 h-16 border-b border-white/[0.06] shrink-0"
  >
    <a
      href={prefix || "/"}
      class="fab-nav-link font-mono font-semibold text-base text-white/90 tracking-tight"
    >
      rebjak<span
        class="text-transparent bg-clip-text"
        style="background-image: linear-gradient(135deg, var(--color-brand-dark), var(--color-violet-dark))"
        >.com</span
      >
    </a>

    <button
      id="fab-theme-toggle"
      class="p-2.5 rounded-xl border border-white/10 text-zinc-400 hover:text-white hover:border-white/20 transition-all"
      aria-label="Toggle theme"
    >
      <svg
        id="fab-icon-sun"
        class="w-5 h-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"
        ></path>
      </svg>
      <svg
        id="fab-icon-moon"
        class="w-5 h-5 hidden"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Nav links centered -->
  <nav class="flex-1 flex flex-col justify-center px-5 gap-1">
    {
      navLinks.map(({ href, label }) => {
        const isActive =
          currentPath === href ||
          (href !== (prefix || "/") && currentPath.startsWith(href));
        return (
          <a
            href={href}
            class:list={[
              "fab-nav-link flex items-center px-4 py-4 rounded-2xl transition-all duration-150 active:scale-[0.98]",
              isActive ? "bg-white/[0.07]" : "hover:bg-white/[0.04]",
            ]}
          >
            <span
              class:list={[
                "text-2xl font-bold font-mono tracking-tight",
                isActive ? "text-white" : "text-zinc-500",
              ]}
            >
              {label}
            </span>
            {isActive && (
              <span
                class="ml-auto w-2 h-2 rounded-full shrink-0"
                style="background: linear-gradient(135deg, var(--color-brand-dark), var(--color-violet-dark));"
              />
            )}
          </a>
        );
      })
    }
  </nav>

  <!-- Bottom: lang switch -->
  <div class="px-5 pb-28 pt-4 border-t border-white/[0.06] shrink-0">
    <a
      href={alternatePath}
      class="fab-nav-link flex items-center justify-center gap-2 w-full py-3.5 rounded-xl border border-white/10 text-sm font-mono font-medium text-zinc-400 hover:text-white hover:border-white/20 transition-all active:scale-[0.98]"
    >
      <svg
        class="w-3.5 h-3.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
        ></path>
      </svg>
      {lang === "sk" ? "English" : "Slovensky"}
    </a>
  </div>
</div>

<script>
  const fab = document.getElementById("fab-open")!;
  const overlay = document.getElementById("fab-overlay")!;
  const iconMenu = document.getElementById("fab-icon-menu")!;
  const iconClose = document.getElementById("fab-icon-close")!;

  // Mobile theme toggle
  const fabThemeBtn = document.getElementById("fab-theme-toggle")!;
  const fabSun = document.getElementById("fab-icon-sun")!;
  const fabMoon = document.getElementById("fab-icon-moon")!;

  function updateFabThemeIcon(isDark: boolean) {
    fabSun.classList.toggle("hidden", !isDark);
    fabMoon.classList.toggle("hidden", isDark);
  }
  updateFabThemeIcon(document.documentElement.classList.contains("dark"));

  fabThemeBtn?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    updateFabThemeIcon(isDark);
    // Sync desktop toggle icons
    const desktopSun = document.getElementById("icon-sun");
    const desktopMoon = document.getElementById("icon-moon");
    if (isDark) {
      desktopSun?.removeAttribute("hidden");
      desktopMoon?.setAttribute("hidden", "");
    } else {
      desktopMoon?.removeAttribute("hidden");
      desktopSun?.setAttribute("hidden", "");
    }
  });

  let isOpen = false;
  let lastScrollY = window.scrollY;

  fab.style.transition =
    "transform 0.3s cubic-bezier(0.16,1,0.3,1), opacity 0.3s ease";

  window.addEventListener(
    "scroll",
    () => {
      if (isOpen) return;
      const current = window.scrollY;
      if (current > lastScrollY + 10) {
        fab.style.transform = "translateY(100px)";
        fab.style.opacity = "0";
      } else if (current < lastScrollY - 5) {
        fab.style.transform = "translateY(0)";
        fab.style.opacity = "1";
      }
      lastScrollY = current;
    },
    { passive: true },
  );

  function openMenu() {
    isOpen = true;
    overlay.style.pointerEvents = "auto";
    overlay.style.opacity = "1";
    overlay.style.transition = "opacity 0.22s cubic-bezier(0.16,1,0.3,1)";
    fab.style.transform = "translateY(0)";
    fab.style.opacity = "1";
    iconMenu.classList.add("hidden");
    iconClose.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    isOpen = false;
    overlay.style.opacity = "0";
    overlay.style.transition = "opacity 0.18s ease";
    setTimeout(() => {
      if (!isOpen) overlay.style.pointerEvents = "none";
    }, 200);
    iconMenu.classList.remove("hidden");
    iconClose.classList.add("hidden");
    document.body.style.overflow = "";
  }

  fab.addEventListener("click", () => {
    isOpen ? closeMenu() : openMenu();
  });

  overlay.querySelectorAll(".fab-nav-link").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) closeMenu();
  });
</script>
